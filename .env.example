# URL base del "bucket" (JSON, imágenes y video).
#
# Desarrollo (sirve public/bucket):
NEXT_PUBLIC_BUCKET_URL=/bucket
#
# Producción (DigitalOcean Spaces + CDN) - no hace falta tocar ningún componente:
# NEXT_PUBLIC_BUCKET_URL=https://titanium-motors.nyc3.cdn.digitaloceanspaces.com

# Segundos de caché (ISR) para los JSON remotos.
DATA_REVALIDATE_SECONDS=300

# ------------------------------------------------------------------
# Supabase (panel admin + inventario en Postgres)
# ------------------------------------------------------------------
# Project Settings → API
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...   # solo servidor / scripts (nunca en el cliente)

# Recorte de fondo (Photoroom). Prefijá sandbox_ para pruebas gratis (marca de agua).
# https://app.photoroom.com/api-dashboard
# PHOTOROOM_API_KEY=
